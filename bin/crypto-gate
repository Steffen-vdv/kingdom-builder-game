#!/bin/bash
# Wrapper script to select the correct crypto-gate binary based on OS and architecture

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Determine OS
case "$(uname -s)" in
  Linux*)
    OS="linux"
    ;;
  Darwin*)
    OS="darwin"
    ;;
  MINGW*|CYGWIN*|MSYS*)
    OS="win"
    ;;
  *)
    echo "Unsupported OS: $(uname -s)" >&2
    exit 1
    ;;
esac

# Determine architecture
case "$(uname -m)" in
  x86_64|amd64)
    ARCH="x64"
    ;;
  arm64|aarch64)
    ARCH="arm64"
    ;;
  *)
    echo "Unsupported architecture: $(uname -m)" >&2
    exit 1
    ;;
esac

# Construct binary name
if [[ "$OS" == "win" ]]; then
  BINARY="$SCRIPT_DIR/crypto-gate-${OS}-${ARCH}.exe"
else
  BINARY="$SCRIPT_DIR/crypto-gate-${OS}-${ARCH}"
fi

if [[ ! -x "$BINARY" ]]; then
  cat >&2 << EOF
╔═══════════════════════════════════════════════════════════════════════════════╗
║  ❌ CRYPTO-GATE BINARY NOT FOUND                                              ║
╚═══════════════════════════════════════════════════════════════════════════════╝

Expected: $BINARY

The crypto-gate binary is only available to subagents.
It is downloaded automatically via the SubagentStart hook.

If you are the master-agent:
  - You cannot use crypto-gate directly. This is by design.
  - Spawn the appropriate subagent (code-reviewer, pusher) to proceed.

If you are a subagent and see this error:
  - The SubagentStart hook may have failed.
  - Report this error to the main agent.

EOF
  exit 1
fi

exec "$BINARY" "$@"
