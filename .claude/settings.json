{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": ["Skill"]
	},
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup",
				"hooks": [
					{
						"type": "command",
						"command": "$CLAUDE_PROJECT_DIR/.claude/agents/hypervisor/scripts/mss.sh"
					}
				]
			},
			{
				"matcher": "resume",
				"hooks": [
					{
						"type": "command",
						"command": "$CLAUDE_PROJECT_DIR/.claude/agents/hypervisor/scripts/msh.sh"
					}
				]
			},
			{
				"matcher": "compact",
				"hooks": [
					{
						"type": "command",
						"command": "$CLAUDE_PROJECT_DIR/.claude/agents/hypervisor/scripts/msh.sh"
					}
				]
			}
		],
		"SubagentStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "$CLAUDE_PROJECT_DIR/.claude/agents/sub-agent/scripts/sss.sh"
					}
				]
			}
		],
		"SubagentStop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "$CLAUDE_PROJECT_DIR/.claude/agents/sub-agent/scripts/subagent-cleanup.sh"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-setup-scripts.sh"
					},
					{
						"type": "command",
						"command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-marker-access.sh"
					},
					{
						"type": "command",
						"command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-direct-downloads.sh"
					},
					{
						"type": "command",
						"command": "$CLAUDE_PROJECT_DIR/.claude/hooks/verify-script-access.sh"
					},
					{
						"type": "command",
						"command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-push-review.sh"
					}
				]
			}
		]
	}
}
