{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": ["Skill"]
	},
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup",
				"hooks": [
					{
						"type": "command",
						"command": "/home/user/kingdom-builder-game/.claude/session-start-docs.sh"
					}
				]
			},
			{
				"matcher": "resume",
				"hooks": [
					{
						"type": "command",
						"command": "/home/user/kingdom-builder-game/.claude/session-start-docs.sh"
					}
				]
			},
			{
				"matcher": "clear",
				"hooks": [
					{
						"type": "command",
						"command": "/home/user/kingdom-builder-game/.claude/session-start-docs.sh"
					}
				]
			},
			{
				"matcher": "compact",
				"hooks": [
					{
						"type": "command",
						"command": "/home/user/kingdom-builder-game/.claude/session-start-docs.sh"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "/home/user/kingdom-builder-game/.claude/hooks/pre-commit-verify.sh"
					}
				]
			}
		]
	}
}
