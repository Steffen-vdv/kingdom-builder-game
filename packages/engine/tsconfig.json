{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "dist",
		"composite": true,
		"declaration": true,
		"rootDirs": [
			"src",
			"../protocol/src",
			"../contents/src",
			"../contents-sdk/src"
		]
	},
	"include": ["src"],
	"exclude": ["dist", "tests"],
